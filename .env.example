APP_ENV=dev
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://postgres:pass@localhost:5432/user_management?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

LOG_LEVEL=debug
LOG_FORMAT=text


JWT_SECRET=change-me-run-openssl-rand-base64-48
JWT_ISSUER=user-management-system
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
AUTH_MAX_CONCURRENT_HASHES=
COOKIE_SECURE=false
COOKIE_DOMAIN=